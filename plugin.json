{
    // Plugin identifiers are globally unique and only contain A-Za-z0-9_-
    "id": "manage-hands-on-env",

    // It is highly recommended to use Semantic Versioning
    // v1.0.4 release note : added functionality to disable a deployment before deleting it to prevent leaving ghost services on API nodes.
    // v1.0.5 release note : added agent hands-on projects
    // v1.0.6 release note : added functionality to delete project in sandbox folder
    // v1.0.7 release note : added loan adviosr agent starter
    // v1.0.8 release note : made various changes to duplicate, delete, and change ownership macros
    // v1.0.9 release note : added delete everything from all user folders option
    // v1.1.0 release note : Plan C refactor - shared HandsOnRunnable base class and split library,
    //                       plugin-level settings (admin project, sandbox folder, AWS region/ids, ...),
    //                       single starter-project list, delete strategies with identical dry-run/real-run
    //                       reports, unit tests and `make check`; fixed the API-node-status NameError,
    //                       duplicate "params" keys and the aws-credentials preset id.
    // v1.2.0 release note : "Hands-on Workshop Console" plugin webapp: every macro feature from one page with
    //                       live progress, log and job history; macro logic extracted into
    //                       managehandsonenv.features and shared by the macros and the webapp; the webapp
    //                       has its own AWS Account setting and missing AWS credentials fail with a clear message.
    "version": "1.2.0",

    // Meta data for display purposes:
    "meta": {
        // label: name of the plugin as displayed, should be short
        "label": "Manage hands-on projects and users",

        // description: longer string to help end users understand what this plugin does
        "description": "This plugin handles duplication and housekeeping of hands-on projects and it also handles enabling and disabling of users",

        "author": "jaeha",

        // icon: must be one of the FontAwesome 5.15.4 icons, complete list here at https://fontawesome.com/v5/docs/
        "icon": "fas fa-hammer",

        // List of tags for filtering the list of plugins
        "tags": [], //for example: ["Machine Learning", "NLP"]

        // URL where the user can learn more about the plugin
        "url": "",

        "licenseInfo": "Apache Software License"
    },
    /* Plugin settings (arrive in plugin_config). Every value has a default matching the
       historical hard-coded value, so an unsaved settings page keeps the old behaviour. */
    "params": [
        {
            "type": "PRESET",
            "name": "aws_account",
            "label": "AWS Account",
            "parameterSetId": "aws-credentials",
            "mandatory": true
        },
        {
            "type": "STRING",
            "name": "admin_project_key",
            "label": "Admin project key",
            "description": "The only project the macros may be run from",
            "defaultValue": "ADMINV4",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "sandbox_folder",
            "label": "Sandbox project folder",
            "description": "Project folder holding the userNN folders",
            "defaultValue": "SANDBOX",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "aws_region",
            "label": "AWS region",
            "defaultValue": "ap-northeast-2",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "rds_instance_id",
            "label": "RDS DB instance identifier",
            "defaultValue": "postgres-mag",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "api_node_instance_id",
            "label": "API node EC2 instance id",
            "defaultValue": "i-0e7ccb12c93ac1df2",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "readonly_project_key",
            "label": "Read-only project key",
            "description": "Project exposing the shared dataset (stop-sharing macro)",
            "defaultValue": "READONLY",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "shared_dataset_name",
            "label": "Shared dataset name",
            "description": "Dataset of the read-only project whose sharing rules are cleaned",
            "defaultValue": "credit_score",
            "mandatory": false
        },
        {
            "type": "STRING",
            "name": "protected_bundle_prefix",
            "label": "Protected deployment/bundle prefix",
            "description": "Project deployments and bundles whose id starts with this prefix are never deleted",
            "defaultValue": "READONLY",
            "mandatory": false
        }
    ]
}
