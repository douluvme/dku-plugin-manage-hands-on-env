/* This file is the descriptor for the python runnable 2-1-delete-starter-projects */
{
    "meta": {
        "label": "1.Delete Starter Projects",
        "description": "Delete starter projects for MLOps/LLM hands-on",
        "category" : "⚠️ Hands-on 2: Housekeeping",
        "icon": "icon-trash"
    },

    /* whether the runnable's code is untrusted */
    "impersonate": false,

    "params": [
        {
            "name": "delete_type",
            "label": "Delete",
            "type": "SELECT",
            "selectChoices" : [
              { "value": "user_num", "label": "starter projects in user folders using user num"},
              { "value": "all_user_folders", "label": "all projects in all user folders"},
              // "root_folder" (all projects in the root folder) is supported by the code but hidden from the menu
              { "value": "sandbox", "label": "all projects in sandbox folder"}
            ],
            "defaultValue": "user_num",
            "mandatory": true
        },
        {
            "type": "BOOLEAN",
            "name": "delete_TF",
            "label": "Perform deletion??",
            "description" : "If checked, projects will be actually deleted. Otherwise, only list will be displayed ",
            "defaultValue": false
        },
        {
            "name": "user_count",
            "label": "Number of users",
            "type": "INT",
            "description": "Number of workshop users whose projects will be deleted. 강사(user99)를 제외한 수강생 수",
            "defaultValue": 33,
            "mandatory": true,
            "visibilityCondition": "model.delete_type == 'user_num'"
        },
        {
            "name": "key_select_method",
            "label": "Select projects to delete",
            "type": "SELECT",
            "selectChoices" : [
              { "value": "from_list", "label": "from a list of standard starter projects"},
              { "value": "from_input", "label": "from user input"}
            ],
            "defaultValue": "from_list",
            "mandatory": true,
            "visibilityCondition": "model.delete_type == 'user_num'"
        },
        /* The choices come from managehandsonenv.starters.STARTERS through the do() function in
           runnable.py (DSS dynamic select). Dynamic choices for macro parameters require a DSS
           version that honours getChoicesFromPython for python runnables; verify on the target
           instance after upgrading the plugin. */
        {
            "name": "project_keys_list",
            "label": "Projects to delete",
            "description" : "Select starter projects you want to delete",
            "type": "MULTISELECT",
            "getChoicesFromPython": true,
            "mandatory": true,
            "visibilityCondition": "model.delete_type == 'user_num' && model.key_select_method == 'from_list'"
        },
        {
            "type": "STRINGS",
            "name": "project_keys_input",
            "label": "Projects to delete",
            "description" : "Type here project keys you want to delete.",
            "mandatory": false,
            "allowDuplicates": false,
            "visibilityCondition": "model.delete_type == 'user_num' && model.key_select_method == 'from_input'"
        },
        {
            "type": "STRINGS",
            "name": "projects_to_keep",
            "label": "Projects to keep",
            "description" : "List here project keys you want to keep. All other projects in the selected folder(s) will be deleted. The project this macro runs from is always kept.",
            "mandatory": false,
            "allowDuplicates": false,
            "visibilityCondition": "model.delete_type == 'root_folder' || model.delete_type == 'sandbox' || model.delete_type == 'all_user_folders'"
        }
    ],

    /* list of required permissions on the project to see/run the runnable */
    "permissions": [],

    /* what the code's run() returns: NONE, HTML, FOLDER_FILE, FILE or URL */
    "resultType": "HTML",

    /* label to use when the runnable's result is not inlined in the UI (ex: for urls) */
    "resultLabel": "created_projects",

    /* for FILE resultType, the extension to use for the temp file */
    "extension": "txt",

    /* for FILE resultType, the type of data stored in the temp file */
    "mimeType": "text/plain",

    /* Macro roles define where this macro will appear in DSS GUI. */
    "macroRoles": [
        {
            "type": "PROJECT_MACROS"
        }
    ]
}
