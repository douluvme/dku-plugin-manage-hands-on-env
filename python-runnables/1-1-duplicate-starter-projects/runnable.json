/* This file is the descriptor for the python runnable 1-1-duplicate-starter-projects */
{
    "meta": {
        "label": "1.Duplicate Starter Projects",
        "description": "Duplicate starter projects for MLOps/LLM hands-on",
        "category" : "⚠️ Hands-on 1: Manage Starter Projects",
        // icon: must be one of the FontAwesome 5.15.4 icons, complete list here at https://fontawesome.com/v5/docs/
        "icon": "far fa-clone fa-1x"
    },

    /* whether the runnable's code is untrusted */
    "impersonate": false,

    "params": [
        {
            "name": "user_count",
            "label": "Number of users",
            "type": "INT",
            "description": "Number of users who will attend the workshop. 강사(user99)를 제외한 수강생 수",
            "defaultValue": 33,
            "mandatory": true
        },
        {
            "name": "key_select_method",
            "label": "Select projects to duplicate",
            "type": "SELECT",
            "selectChoices" : [
              { "value": "from_list", "label": "from a list of standard starter projects"},
              { "value": "from_input", "label": "from user input"}
            ],
            "defaultValue": "from_list",
            "mandatory": true
        },
        /* The choices come from managehandsonenv.starters.STARTERS through the do() function in
           runnable.py (DSS dynamic select). Dynamic choices for macro parameters require a DSS
           version that honours getChoicesFromPython for python runnables; verify on the target
           instance after upgrading the plugin. */
        {
            "name": "project_keys_list",
            "label": "Project keys to duplicate",
            "type": "MULTISELECT",
            "getChoicesFromPython": true,
            "mandatory": true,
            "visibilityCondition": "model.key_select_method == 'from_list'"
        },
        {
            "type": "STRINGS",
            "name": "project_keys_input",
            "label": "Projects to duplicate",
            "description" : "Type here project keys you want to duplicate.",
            "mandatory": false,
            "allowDuplicates": false,
            "visibilityCondition": "model.key_select_method == 'from_input'"
        }
    ],

    /* list of required permissions on the project to see/run the runnable */
    "permissions": [],

    /* what the code's run() returns: NONE, HTML, FOLDER_FILE, FILE or URL */
    "resultType": "HTML",

    /* label to use when the runnable's result is not inlined in the UI (ex: for urls) */
    "resultLabel": "created_projects",

    /* for FILE resultType, the extension to use for the temp file */
    "extension": "txt",

    /* for FILE resultType, the type of data stored in the temp file */
    "mimeType": "text/plain",

    /* Macro roles define where this macro will appear in DSS GUI. */
    "macroRoles": [
        {
            "type": "PROJECT_MACROS"
        }
    ]
}
